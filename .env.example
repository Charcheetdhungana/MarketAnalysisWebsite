# Copy this file to .env for local testing. NEVER commit the real .env file.
# In GitHub these same four names go into Settings -> Secrets and variables -> Actions.

# From Supabase -> Project Settings -> Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# From Supabase -> Settings -> API Keys -> Secret key (write access, NEVER share)
# New style starts with sb_secret_. The old service_role key (eyJ...) also
# works, but Supabase is retiring it by the end of 2026.
SUPABASE_SERVICE_KEY=sb_secret_...

# From Google AI Studio -> Get API key
GEMINI_API_KEY=AIza...

# Optional. Defaults to gemini-3.5-flash if left out.
GEMINI_MODEL=gemini-3.5-flash
